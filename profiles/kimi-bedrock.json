{
  "agent": "opencode",
  "model": "amazon-bedrock/us.moonshotai.kimi-k3",
  "aws": {
    "profile": "${OCSB_AWS_PROFILE:-default}",
    "region": "${OCSB_AWS_REGION:-us-east-1}"
  },
  "allowedDomains": [
    "bedrock-runtime.${OCSB_AWS_REGION:-us-east-1}.amazonaws.com:443"
  ],
  "opencode": {
    "enabled_providers": [
      "amazon-bedrock"
    ],
    "provider": {
      "amazon-bedrock": {
        "options": {
          "region": "${OCSB_AWS_REGION:-us-east-1}"
        },
        "models": {
          "us.moonshotai.kimi-k3": {
            "name": "Kimi K3 (Bedrock)",
            "tool_call": true,
            "reasoning": true,
            "limit": {
              "context": 1000000,
              "output": 64000
            }
          }
        }
      }
    }
  }
}
